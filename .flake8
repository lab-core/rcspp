[flake8]
max-line-length = 100
# N806: a local variable may keep a mathematical name (G for a graph, A for a matrix).
# A003: an attribute (Node.id) shadows no built-in; the rule is for arguments and variables.
extend-ignore = E203, W503, N806, A003
# N: pep8-naming, A: flake8-builtins (both installed by the pre-commit hook).
extend-select = N, A
# filter= is kept as the pools' keyword (analysis of the renames: "polish").
builtins-ignorelist = filter
exclude = .git, __pycache__, build, dist, .venv, env, migrations
select = "B,C,E,F,W,T4,B9,D"  # B: bugbear, D: docstrings, F/W: pyflakes/pycodestyle
application-import-names = ["rcspp"]
per-file-ignores =
    __init__.py:F401
    # rcspp.resource is public API; the module only shares its name with the Unix-only stdlib one.
    python/src/rcspp/resource.py:A005
    # Generated stubs (scripts/generate_stubs.py): one-line bodies, no blank lines between stubs.
    # Their generated class names (real_int_resource_graph, ExtensionFunction_real) are kept.
    *.pyi:E301,E302,E305,E501,E704,N801
