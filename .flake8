[flake8]
max-line-length = 100
extend-ignore = E203, W503
exclude = .git, __pycache__, build, dist, .venv, env, migrations
select = "B,C,E,F,W,T4,B9,D"  # B: bugbear, D: docstrings, F/W: pyflakes/pycodestyle
application-import-names = ["rcspp"]
per-file-ignores =
    __init__.py:F401
    # Generated stubs (scripts/generate_stubs.py): one-line bodies, no blank lines between stubs.
    *.pyi:E301,E302,E305,E501,E704
