# Doxyfile for rcspp — generates XML consumed by Breathe/Exhale.
# Run from the docs/ directory: doxygen Doxyfile

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = "rcspp"
PROJECT_BRIEF          = "Resource-Constrained Shortest Path Problem — C++ library with Python bindings"
PROJECT_NUMBER         =
OUTPUT_DIRECTORY       = .

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
INPUT                  = ../cpp/rcspp
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.cpp *.h
EXCLUDE_PATTERNS       = */test* *_test.* */extern/*
STRIP_FROM_PATH        = ../

#---------------------------------------------------------------------------
# Extraction
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
JAVADOC_AUTOBRIEF      = NO
QT_AUTOBRIEF           = NO

#---------------------------------------------------------------------------
# Build
#---------------------------------------------------------------------------
BUILTIN_STL_SUPPORT    = YES
CPP_CLI_SUPPORT        = NO
CLANG_ASSISTED_PARSING = NO

#---------------------------------------------------------------------------
# Output: XML only (Breathe/Exhale consume XML; we don't need HTML)
#---------------------------------------------------------------------------
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = _doxygen/xml
XML_PROGRAMLISTING     = NO

#---------------------------------------------------------------------------
# Diagrams (disabled — no graphviz required on CI)
#---------------------------------------------------------------------------
HAVE_DOT               = NO

#---------------------------------------------------------------------------
# Misc
#---------------------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
GENERATE_TODOLIST      = NO
GENERATE_TESTLIST      = NO
GENERATE_BUGLIST       = NO
MACRO_EXPANSION        = NO
PREDEFINED             =
ENABLE_PREPROCESSING   = YES
SORT_MEMBER_DOCS       = NO
