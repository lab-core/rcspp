# rcspp's CMake package: find_package(rcspp), then link rcspp::rcspp.
#
# Components, each available when rcspp was built with it:
#   column_generation        → rcspp::column_generation        (USE_COLUMN_GENERATION)
#   column_generation_highs  → rcspp::column_generation_highs  (USE_COLUMN_GENERATION_HIGHS)
#   column_generation_gurobi → rcspp::column_generation_gurobi (USE_COLUMN_GENERATION_GUROBI)
# e.g. find_package(rcspp REQUIRED COMPONENTS column_generation_highs). A master solver brings
# column generation with it.

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

include("${CMAKE_CURRENT_LIST_DIR}/rcsppTargets.cmake")

# A master solver needs column generation.
set(_rcspp_requested ${rcspp_FIND_COMPONENTS})
if(("column_generation_highs" IN_LIST _rcspp_requested
    OR "column_generation_gurobi" IN_LIST _rcspp_requested)
   AND NOT "column_generation" IN_LIST _rcspp_requested)
  list(APPEND _rcspp_requested column_generation)
endif()

# In this order: column generation before its master solvers.
foreach(_rcspp_component column_generation column_generation_highs column_generation_gurobi)
  if(NOT _rcspp_component IN_LIST _rcspp_requested)
    continue()
  endif()

  set(_rcspp_targets "${CMAKE_CURRENT_LIST_DIR}/rcspp-${_rcspp_component}-targets.cmake")
  if(NOT EXISTS "${_rcspp_targets}")
    set(rcspp_${_rcspp_component}_FOUND FALSE)
    set(rcspp_NOT_FOUND_MESSAGE "rcspp was built without the component ${_rcspp_component}")
    continue()
  endif()

  # The solver each master solver links.
  if(_rcspp_component STREQUAL "column_generation_highs")
    find_dependency(highs CONFIG)
  elseif(_rcspp_component STREQUAL "column_generation_gurobi")
    list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")  # FindGUROBI.cmake
    set(GUROBI_REQUIRE_CXX ON)
    find_dependency(GUROBI)
  endif()

  include("${_rcspp_targets}")
  set(rcspp_${_rcspp_component}_FOUND TRUE)
endforeach()

unset(_rcspp_requested)
unset(_rcspp_component)
unset(_rcspp_targets)

check_required_components(rcspp)
